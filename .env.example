# .env
# Database Connection Configuration
DB_URL=postgresql://connect:connect@localhost:5435/advp

# Vertica Configuration
VERTICA_HOST=localhost
VERTICA_PORT=5433
VERTICA_DB=VMart
VERTICA_USER=dbadmin
VERTICA_PASSWORD=changeme

# Schema and Table Filtering Configuration
# Limit access to specific schemas and tables by setting these values

# Comma-separated list of allowed schemas (leave empty to allow all schemas)
ALLOWED_SCHEMAS=DPW_DL

# Comma-separated list of allowed tables (leave empty to allow all tables)
ALLOWED_TABLES=T_DA_HRLY_PROD_DTLS,T_DA_EQP_HRLY_PROD_DTLS,T_DA_DELAY_HRLY_PROD_DTLS,T_DA_CONTR_CYCLE_SUMRY,DM_TARGETS,T_SLA_HOURLY_DTLS,DELAYS_T2_2H,T_ACTIVITY_DESC,T_DELAYS_REMARKS

# To customize for your database:
# 1. Set ALLOWED_SCHEMAS to your schema names (e.g., "public,analytics,reporting")
# 2. Set ALLOWED_TABLES to your table names (e.g., "users,orders,products")
# 3. Leave either empty to allow all schemas or all tables respectively

# Logging Configuration
LOG_PATH=logs/app.log
